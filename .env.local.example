# ============================================================
# 微信开放平台 OAuth 扫码登录 配置
# ============================================================
# 使用说明：
#   1. 复制此文件为 .env.local
#   2. 前往 https://open.weixin.qq.com 注册开发者账号
#   3. 创建"网站应用"，获取 AppID 和 AppSecret
#   4. 在微信开放平台填写回调域名（redirect_uri 的域名部分）
#   5. 将以下变量填入 .env.local
#
# 注意：
#   - .env.local 不会提交到 Git（已在 .gitignore 中）
#   - 未配置时前端会自动降级为演示模式（模拟登录）
#   - 生产环境请务必将内存存储替换为 Redis
# ============================================================

# 微信开放平台 AppID（必填）
WECHAT_APP_ID=wx_your_app_id_here

# 微信开放平台 AppSecret（必填，请妥善保管）
WECHAT_APP_SECRET=your_app_secret_here

# OAuth 回调地址（必填）
# 必须是微信开放平台已注册的回调域名下的完整 URL
# 开发环境可使用 ngrok 等内网穿透工具
# 示例：https://your-domain.com/api/wechat/callback
WECHAT_REDIRECT_URI=https://localhost:3000/api/wechat/callback
